[Unit]
Description=Soundalike catalog crawl (Deezer related artists -> previews)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/soundalike
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# The crawler runs from its own copy of the package so API deploys never change it mid-crawl.
Environment=PYTHONPATH=/opt/soundalike/crawl-src
# Resumable: a restart continues from the SQLite state; the run exits 0 once --target new songs are saved.
ExecStart=/opt/soundalike/venv/bin/python -m soundalike.anysong.crawl run \
    --scene /opt/soundalike/index/scene.npz --meta /opt/soundalike/index/catalog_meta.npz \
    --db /data/crawl/crawl.sqlite --previews /data/previews --target 730000
Restart=on-failure
RestartSec=60
KillSignal=SIGTERM
TimeoutStopSec=150
Nice=10
IOSchedulingClass=idle
CPUQuota=200%
MemoryMax=2G
TasksMax=96
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/crawl /data/previews

[Install]
WantedBy=multi-user.target
