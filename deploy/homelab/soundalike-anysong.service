[Unit]
Description=Soundalike any-song API (GPU)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=anysong
Group=anysong
WorkingDirectory=/opt/soundalike
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/soundalike/src
Environment=HOME=/var/lib/anysong
Environment=HF_HOME=/opt/soundalike/hf
Environment=HF_HUB_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=LANG=C.UTF-8
Environment=OMP_NUM_THREADS=4
Environment=SAMPLEID_CKPT=/opt/soundalike/ckpt/sampleid/sampleid-best.ckpt
Environment=CLEWS_CKPT=/opt/soundalike/ckpt/clews
Environment=SOUNDALIKE_EXT=/opt/soundalike/ext
Environment=ANYSONG_HOST=192.168.1.47
Environment=ANYSONG_PORT=8790
# /opt/soundalike/index/current points at an index_build output that also holds the catalog tables it was built with
# (catalog_meta, languages, scene, tempo) and core_ids.npy, the songs of the catalog before anysong.crawl grew it
# (anysong.tiers), so swapping the symlink swaps them together. Grown indexes live on the backup-excluded NVMe volume
# /opt/soundalike/index-store.
# Rate limits are keyed on CF-Connecting-IP (set by Cloudflare) so proxied users don't share one bucket.
# Only trust it while this port is reachable solely through the Cloudflare tunnel / proxy chain.
# Responses are public, credential-free GETs, so any origin may read them (the Spotify desktop client needs this).
ExecStart=/opt/soundalike/venv/bin/python -m soundalike.anysong.api \
    --index /opt/soundalike/index/current --meta /opt/soundalike/index/current/catalog_meta.npz \
    --languages /opt/soundalike/index/current/languages.npz \
    --scene /opt/soundalike/index/current/scene.npz --core-ids /opt/soundalike/index/current/core_ids.npy \
    --tempo /opt/soundalike/index/current/tempo.npz --tempo-model /opt/soundalike/ckpt/beat_this/final0.ckpt \
    --learn-queue /var/lib/anysong/learn-queue.jsonl \
    --host ${ANYSONG_HOST} --port ${ANYSONG_PORT} --client-ip-header CF-Connecting-IP --cors-origin "*"
Restart=always
RestartSec=5
TimeoutStartSec=300
MemoryMax=6G
TasksMax=128
UMask=0027
StateDirectory=anysong
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/anysong

[Install]
WantedBy=multi-user.target
