[Unit]
Description=Soundalike any-song API (GPU)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=anysong
Group=anysong
WorkingDirectory=/opt/soundalike
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/soundalike/src
Environment=HOME=/var/lib/anysong
Environment=HF_HOME=/opt/soundalike/hf
Environment=HF_HUB_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=LANG=C.UTF-8
Environment=OMP_NUM_THREADS=4
Environment=SAMPLEID_CKPT=/opt/soundalike/ckpt/sampleid/sampleid-best.ckpt
Environment=CLEWS_CKPT=/opt/soundalike/ckpt/clews
Environment=SOUNDALIKE_EXT=/opt/soundalike/ext
# ANYSONG_HOST, the LAN address the API listens on, is set on the host: /etc/soundalike/anysong.env holds the one line
# ANYSONG_HOST=<address>. Without the file the unit does not start.
EnvironmentFile=/etc/soundalike/anysong.env
Environment=ANYSONG_PORT=8790
# /opt/soundalike/index/current points at one index directory that holds everything the service reads of an index
# (python -m soundalike.anysong.index_check <dir> lists and checks it): the melody, samples and sonic indexes, the scene
# heads (heads/), the playlist vectors (playlists/), the catalog tables (catalog_meta, languages, scene, tempo,
# durations: song lengths, so that an answer can say where the preview sits in the song),
# core_ids.npy, the songs of the catalog before anysong.crawl grew it (anysong.tiers), ranker.npz, the listener ranker
# trained on these tables (anysong.listener) with its popularity.npz, the match and overall scales, and the consensus
# model with its quantiles (anysong.consensus). Swapping the symlink swaps them together. Indexes live on the
# backup-excluded NVMe volume /opt/soundalike/index-store. Models stay under /opt/soundalike/ckpt, the Whisper language
# model (the catalog's labelling model, for the language of songs outside the catalog) in ckpt/whisper-large-v3-turbo.
# The 8 GB card cannot hold a million songs' tables next to the models: --host-tables keeps the samples and sonic
# stage-1 projections and the blend's head table in the file cache and reads them for each request, and
# --consensus-windows stream does the same for the consensus body's sonic windows (docs/ANYSONG.md, "Deployment").
# Rate limits are keyed on CF-Connecting-IP (set by Cloudflare) so proxied users don't share one bucket.
# Only trust it while this port is reachable solely through the Cloudflare tunnel / proxy chain.
# Responses are public, credential-free GETs, so any origin may read them (the Spotify desktop client needs this).
# --parts: similar takes part=<start>-<end>, a span of the 30 s preview as the seed (docs/ANYSONG.md, "A part of a
# song"); it uses the windows the index already holds and loads nothing more.
# --excerpts: POST /api/anysong/excerpt takes a clip of the listener's own audio, 10 to 30 s, so that any part of a
# song can be matched (owner's decision, 2026-11-24). One clip at a time, 6 a minute per client, 6 MB at most, WAV
# only: --excerpt-formats is left at its default so that no decoder library reads bytes anyone can send. Nothing of
# a clip is written or logged. Naming a clip's song (--identify-score) stays off: clients send the song's id.
ExecStart=/opt/soundalike/venv/bin/python -m soundalike.anysong.api \
    --index /opt/soundalike/index/current --meta /opt/soundalike/index/current/catalog_meta.npz \
    --languages /opt/soundalike/index/current/languages.npz \
    --language-model /opt/soundalike/ckpt/whisper-large-v3-turbo \
    --scene /opt/soundalike/index/current/scene.npz --core-ids /opt/soundalike/index/current/core_ids.npy \
    --tempo /opt/soundalike/index/current/tempo.npz --tempo-model /opt/soundalike/ckpt/beat_this/final0.ckpt \
    --durations /opt/soundalike/index/current/durations.npz \
    --ranker /opt/soundalike/index/current/ranker.npz --head /opt/soundalike/index/current/heads/h2 \
    --popularity /opt/soundalike/index/current/popularity.npz \
    --match-quantiles /opt/soundalike/index/current/match_quantiles.json \
    --overall /opt/soundalike/index/current/overall.json \
    --main-pool sonic+blend --main-match-floor 50 --main-listener-weight 2 --main-scale 0.0363 1.53 \
    --main-blend-weight 1 --blend-head /opt/soundalike/index/current/heads/h4 \
    --blend-cf /opt/soundalike/index/current/playlists --blend-weights 2 1 1 --head-all-languages \
    --consensus-model /opt/soundalike/index/current/consensus.npz \
    --consensus-quantiles /opt/soundalike/index/current/consensus_quantiles.json \
    --consensus-sound-weight 0.1 --consensus-sound-cap 5011 \
    --host-tables samples sonic head --consensus-windows stream \
    --stems /opt/soundalike/stems/ablation60k-v2 --stems-model /opt/soundalike/ckpt/demucs \
    --stems-cache /var/lib/anysong/stems --catalog-previews /data/previews \
    --half-stage1 samples --parts \
    --excerpts --excerpt-per-min 6 --excerpt-max-mb 6 \
    --learn-queue /var/lib/anysong/learn-queue.jsonl \
    --host ${ANYSONG_HOST} --port ${ANYSONG_PORT} --client-ip-header CF-Connecting-IP --cors-origin "*"
Restart=always
RestartSec=5
TimeoutStartSec=300
# The process itself needs about 5.5 GB (4.1 GB before v12); the rest is file cache for the tables read on every
# request (samples/proj.npy, sonic/proj.npy, sonic/full.npy, heads/h4.emb.npy: 8.1 GB together), which must stay
# cached or every request waits for the disk, and for the exact re-scoring's random reads. The container needs 16 GB.
MemoryMax=14G
TasksMax=128
UMask=0027
StateDirectory=anysong
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/anysong

[Install]
WantedBy=multi-user.target
